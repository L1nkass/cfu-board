# ============================================================
#  CFU-Board — пример окружения для docker compose (корень монорепо)
#  Скопируйте в .env и заполните своими значениями:
#      cp .env.example .env
#  Файл .env НЕ попадает в git.
#
#  Локальный запуск бэкенда без Docker использует backend/.env
#  (см. backend/.env.example) — там DATABASE_URL указывает на localhost.
# ============================================================

# --- Режим работы: development | production ---
APP_ENV=production

# Секрет подписи JWT. ОБЯЗАТЕЛЕН. Сгенерируйте длинный случайный ключ:
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_string

# --- База данных (сервис postgres в compose) ---
DB_USER=linkass
DB_PASSWORD=change_me_strong_password
DB_NAME=cfu-board
# Внешний порт PostgreSQL на хосте (если 5432 занят — смените, напр. 5433).
DB_HOST_PORT=5432
DB_AUTO_MIGRATE=true

# --- Публичный адрес сервиса (для ссылок верификации в письмах) ---
PUBLIC_BASE_URL=http://localhost:8080

# --- SMTP для писем подтверждения (пусто — письма только логируются) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- MinIO (S3-хранилище медиа) ---
STORAGE_DRIVER=minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cfu-board
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
