# ============================================================
#  Пример конфигурации CFU-Board
#  Скопируйте этот файл в .env и заполните своими значениями:
#      cp .env.example .env
#  Файл .env НЕ попадает в git (см. .gitignore).
# ============================================================

# --- Режим работы: development | production ---
# В production логи выводятся в JSON, а JWT_SECRET обязан быть длиннее 32 символов.
APP_ENV=development

# --- HTTP-сервер ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=10s
# Общий таймаут обработки одного запроса (с запасом на загрузку медиа до 500MB).
HTTP_REQUEST_TIMEOUT=60s
# Список разрешённых CORS-источников через запятую, "*" — разрешить всем.
HTTP_ALLOWED_ORIGINS=*

# Внешний адрес сервиса для абсолютных ссылок в письмах.
# За реверс-прокси укажите здесь публичный домен (например, https://cfu.example.com).
# Если не задан — берётся http://<HTTP_HOST>:<HTTP_PORT>.
PUBLIC_BASE_URL=http://localhost:8080

# --- База данных PostgreSQL ---
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=cfu-board

# Строка подключения (используется пулом соединений pgx)
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/cfu-board?sslmode=disable

# Настройки пула соединений
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_IDLE_TIME=15m
# Автоматически накатывать миграции при старте (true/false)
DB_AUTO_MIGRATE=true

# --- JWT ---
# Сгенерируйте длинный случайный ключ, например:  openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_ACCESS_TTL=60m        # срок жизни access-токена (по умолчанию 60 минут)
JWT_REFRESH_TTL=720h      # срок жизни refresh-токена (по умолчанию 30 дней)
# --- Подтверждение email ---
VERIFY_TOKEN_TTL=15m        # срок жизни токена подтверждения
VERIFY_RESEND_COOLDOWN=60s  # минимальный интервал между повторными письмами
VERIFY_MAX_PER_HOUR=5       # максимум писем подтверждения на пользователя в час

# --- SMTP для писем подтверждения ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password

# --- Хранилище медиафайлов публикаций ---
# Приложение сохраняет медиа в объектное S3-совместимое хранилище MinIO.
STORAGE_DRIVER=minio

# Настройки MinIO:
#   MINIO_ENDPOINT    — хост:порт S3-API. В docker-сети: "minio:9000",
#                       при локальном запуске приложения: "localhost:9000".
#   MINIO_PUBLIC_URL  — базовый URL, по которому фронтенд открывает медиа
#                       (должен быть доступен из браузера, напр. http://localhost:9000).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cfu-board
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
